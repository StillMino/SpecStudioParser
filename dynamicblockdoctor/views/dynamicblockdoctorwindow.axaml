<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpecStudioParser.DynamicBlockDoctor.ViewModels"
        x:Class="SpecStudioParser.DynamicBlockDoctor.Views.DynamicBlockDoctorWindow"
        Title="Dynamic Block Doctor"
        Width="850" Height="680"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource AppBackgroundBrush}">

  <Design.DataContext>
    <vm:DynamicBlockDoctorViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

    <!-- Заголовок -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Dynamic Block Doctor" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Диагностика и починка динамических блоков" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- Сводная статистика -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,Auto" Margin="0,0,0,8">
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="Всего блоков" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBlock Text="{Binding TotalBlocks}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="Динамических" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBlock Text="{Binding DynamicBlocks}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="Ошибки" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBlock Text="{Binding ErrorCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,6,0">
        <StackPanel>
          <TextBlock Text="Предупреждения" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBlock Text="{Binding WarningCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
      </Border>
      <Button Grid.Column="4" Content="Диагностика" Command="{Binding DiagnoseCommand}"
              Classes="accentButton" Padding="16,10"
              VerticalAlignment="Stretch"/>
    </Grid>

    <!-- Основная область -->
    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,8">

      <!-- Список блоков -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,6,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Блоки на чертеже" FontWeight="SemiBold" Padding="8,6"
                     Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Reports}"
                   SelectedItem="{Binding SelectedReport}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding BlockName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding WorstSeverity}" FontSize="11"/>
                    <TextBlock Text="{Binding EntityCount, StringFormat='{}{0} примит.'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ApproxSizeKB, StringFormat='{}~{0} KB'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Детали проблем -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Проблемы и рекомендации" FontWeight="SemiBold"
                     Padding="8,6" Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextBrush}"/>
          <ScrollViewer Grid.Row="1" Padding="8">
            <ItemsControl ItemsSource="{Binding SelectedIssues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Recommendation}" FontSize="12" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="2" Content="Заморозить блок"
                  Command="{Binding FreezeCommand}"
                  Classes="dangerButton commandButton"
                  Margin="8"/>
        </Grid>
      </Border>

    </Grid>

    <!-- Статус -->
    <TextBlock Grid.Row="3" Text="{Binding StatusText}"
               TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Padding="0,4"/>

  </Grid>
</Window>
