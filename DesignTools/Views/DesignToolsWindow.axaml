<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpecStudioParser.DesignTools.ViewModels"
        xmlns:conv="using:SpecStudioParser.DesignTools.Converters"
        x:Class="SpecStudioParser.DesignTools.Views.DesignToolsWindow"
        x:DataType="vm:DesignToolsViewModel"
        Title="Инструменты проектировщика"
        Width="300"
        Height="640"
        MinWidth="260"
        MinHeight="480"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="{StaticResource AppBackgroundBrush}">

	<Window.Resources>
		<conv:GeometryPathConverter x:Key="GeometryPathConverter"/>
		<conv:CollisionThresholdVisibilityConverter x:Key="CollisionThresholdVisibility"/>
	</Window.Resources>

	<Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Background="{StaticResource AppBackgroundBrush}">

		<!-- Header -->
		<Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Инструменты проектировщика" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="{Binding Version}" Margin="6,0,0,0" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
				</StackPanel>
				<Button Grid.Column="1" Classes="neutralButton" Command="{Binding RefreshContextCommand}" Padding="6,2" ToolTip.Tip="Обновить документ">
					<TextBlock Text="↻" FontSize="13"/>
				</Button>
			</Grid>
		</Border>

		<!-- Filter pills -->
		<Border Grid.Row="1" Padding="8,4,8,4">
			<WrapPanel Orientation="Horizontal">
				<Button Content="Все" Command="{Binding SelectFilterCommand}" CommandParameter="all" Padding="8,3" Margin="0,0,4,2" FontSize="10" Classes="neutralButton"/>
				<Button Content="2D" Command="{Binding SelectFilterCommand}" CommandParameter="drafting" Padding="8,3" Margin="0,0,4,2" FontSize="10" Classes="neutralButton"/>
				<Button Content="3D" Command="{Binding SelectFilterCommand}" CommandParameter="model" Padding="8,3" Margin="0,0,4,2" FontSize="10" Classes="neutralButton"/>
				<Button Content="Диагн." Command="{Binding SelectFilterCommand}" CommandParameter="diagnostics" Padding="8,3" Margin="0,0,4,2" FontSize="10" Classes="neutralButton"/>
				<Button Content="Spec" Command="{Binding SelectFilterCommand}" CommandParameter="specifier" Padding="8,3" Margin="0,0,4,2" FontSize="10" Classes="neutralButton"/>
			</WrapPanel>
		</Border>

		<!-- Search -->
		<Border Grid.Row="2" Padding="8,0,8,6">
			<TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			         Watermark="🔍 Поиск инструмента..."
			         FontSize="11"
			         MinHeight="28"
			         Padding="8,4"/>
		</Border>

		<!-- Tool list -->
		<ScrollViewer Grid.Row="3">
			<ItemsControl ItemsSource="{Binding ToolCards}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DesignToolCardViewModel">

						<StackPanel>
							<!-- Tool row: clickable button with accent bar when active -->
							<Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding ToggleExpandCommand}">
								<Grid ColumnDefinitions="3, 32, *, Auto" Margin="8,6">

									<!-- Active accent bar -->
									<Border Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" IsVisible="{Binding IsExpanded}" HorizontalAlignment="Left" Margin="0,0,3,0"/>

									<!-- Icon -->
									<Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" BorderBrush="#E8D5C5" BorderThickness="1">
										<Viewbox Width="20" Height="20" Stretch="Uniform">
											<Path Data="{Binding IconGeometry, Converter={StaticResource GeometryPathConverter}}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"/>
										</Viewbox>
									</Border>

									<!-- Name + desc -->
									<StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
											<Border Background="#FFF3DC" BorderBrush="#F0DCA0" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" IsVisible="{Binding IsStub}">
												<TextBlock Text="WIP" FontSize="8" Foreground="#8A6519" FontWeight="Bold"/>
											</Border>
										</StackPanel>
										<TextBlock Text="{Binding Description}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
									</StackPanel>

									<!-- Status dot -->
									<StackPanel Grid.Column="3" VerticalAlignment="Center">
										<Ellipse Width="7" Height="7" Fill="#3D8B3D" IsVisible="{Binding IsOk}"/>
										<Ellipse Width="7" Height="7" Fill="{StaticResource DangerBrush}" IsVisible="{Binding IsError}"/>
										<Ellipse Width="7" Height="7" Fill="#BBB" IsVisible="{Binding IsIdle}"/>
									</StackPanel>
								</Grid>
							</Button>

							<!-- Config section (only when expanded) -->
							<Border IsVisible="{Binding IsExpanded}" Background="#FAFAF8" Padding="10,4,10,8">
							<StackPanel>

								<!-- Dropdowns -->
								<WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
									<ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" FontSize="10" MinHeight="24" Margin="0,0,4,3" IsVisible="{Binding HasSources}"/>
									<ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" FontSize="10" MinHeight="24" Margin="0,0,4,3" IsVisible="{Binding HasOperations}"/>
									<ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" FontSize="10" MinHeight="24" Margin="0,0,4,3" IsVisible="{Binding HasAxes}"/>
									<ComboBox ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}" IsEnabled="{Binding IsReferenceEnabled}" FontSize="10" MinHeight="24" Margin="0,0,4,3" IsVisible="{Binding HasReferences}"/>
								</WrapPanel>

								<!-- Threshold (collision cleanup only) -->
								<StackPanel Orientation="Horizontal" Margin="0,0,0,4" IsVisible="{Binding Id, Converter={StaticResource CollisionThresholdVisibility}}">
									<TextBlock Text="Порог:" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource SecondaryTextBrush}"/>
									<NumericUpDown Value="{Binding MinDistanceThreshold}" Minimum="0" Maximum="1000" Increment="0.5" FontSize="10" MinHeight="24"/>
								</StackPanel>

								<!-- Run button -->
								<Button Command="{Binding RunCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,5" Margin="0,2,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" CornerRadius="4">
									<TextBlock Text="▶ Запустить" FontSize="11" FontWeight="Medium" Foreground="White"/>
								</Button>

								<!-- Status text -->
								<TextBlock Text="{Binding Status}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" IsVisible="{Binding HasStatus}"/>
							</StackPanel>
							</Border>
						</StackPanel>

					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- Footer -->
		<Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,5">
			<Grid ColumnDefinitions="Auto, *">
				<TextBlock Grid.Column="0" Text="{Binding DocumentStatus}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
				<TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="9" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
			</Grid>
		</Border>
	</Grid>
</Window>
