<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpecStudioParser.PositionNumbering.ViewModels"
        x:Class="SpecStudioParser.PositionNumbering.Views.PositionNumberingWindow"
        Title="Position Numbering Engine"
        Width="750" Height="640"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource AppBackgroundBrush}">

  <Design.DataContext>
    <vm:PositionNumberingViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

    <!-- Заголовок -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Position Numbering Engine" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Автоматическая нумерация позиций" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- Настройки -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,6,0">
        <TextBlock Text="Префикс:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox Text="{Binding Prefix}" Watermark="(нет)"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,6,0">
        <TextBlock Text="Начальный №:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox Text="{Binding StartNumber}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,6,0">
        <TextBlock Text="Шаг:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox Text="{Binding Step}"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="3">
        <TextBlock Text="Сортировка:" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
        <ComboBox ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSortOption}"
                  MinWidth="180"/>
      </StackPanel>
    </Grid>

    <!-- Доп. настройки -->
    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox IsChecked="{Binding OverwriteExisting}" Content="Перезаписывать" Margin="0,0,12,0"/>
      <TextBlock Text="Тег:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,4,0"/>
      <TextBox Text="{Binding TargetAttributeTag}" MinWidth="70"/>
      <TextBlock Text="Слой:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="12,0,4,0"/>
      <TextBox Text="{Binding LeaderLayerFilter}" Watermark="(все)" MinWidth="90"/>
    </WrapPanel>

    <!-- Таблица -->
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
      <DataGrid ItemsSource="{Binding Positions}"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                HeadersVisibility="Column"/>
    </Border>

    <!-- Кнопки -->
    <Grid Grid.Row="4" ColumnDefinitions="*,110,110">
      <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                 VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
      <Button Grid.Column="1" Content="Сканировать"
              Command="{Binding ScanCommand}"
              Classes="neutralButton commandButton"
              Margin="0,0,6,0"/>
      <Button Grid.Column="2" Content="Применить"
              Command="{Binding ApplyCommand}"
              Classes="accentButton commandButton"/>
    </Grid>

  </Grid>
</Window>
